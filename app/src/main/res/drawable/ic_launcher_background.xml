<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sombra (capa inferior) -->
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <!-- negro con más opacidad -->
            <solid android:color="#33000000" />
        </shape>
    </item>

    <!-- Fondo principal (capa superior) -->
    <item
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <!-- color del fondo del icono -->
            <solid android:color="#2A6FFF" />
        </shape>
    </item>

</layer-list>
